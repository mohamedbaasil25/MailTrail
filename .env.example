# MailTrail Threat API Configuration
# Copy this file to .env and configure for your environment

# MongoDB
MONGO_URI=mongodb://mongodb:27017/
MONGO_DB_NAME=email_intelligence_db

# Security
# Generate a strong key for JWT_SECRET_KEY, e.g. using `openssl rand -hex 32`
JWT_SECRET_KEY=supersecretkey_please_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Admin Credentials (bcrypt hashes)
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD_HASH=$2b$12$LrExbvOTRgBRZqisfyGKUOlvCEBTXyAa2qFDek8yt6Vems7UrZiWK

# Analyst Credentials (bcrypt hashes)
# ANALYST_USERNAME=analyst
# ANALYST_PASSWORD_HASH=$2b$12$0cVHZzt7RqT5BTAgNZZbbOybx4plrJklXewhawpsSNlV9943DyTxG

# Email Integration (Optional)
IMAP_SERVER=
IMAP_USER=
IMAP_PASS=
