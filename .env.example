# MailTrail Threat API Configuration
# Copy this file to .env and configure for your environment

# MongoDB
MONGO_URI=mongodb://mongodb:27017/
MONGO_DB_NAME=email_intelligence_db

# Security
# Generate a strong key for JWT_SECRET_KEY, e.g. using `openssl rand -hex 32`
JWT_SECRET_KEY=supersecretkey_please_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Admin Credentials (bcrypt hashes)
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD_HASH=$2b$12$LrExbvOTRgBRZqisfyGKUOlvCEBTXyAa2qFDek8yt6Vems7UrZiWK

# Analyst Credentials (bcrypt hashes)
# ANALYST_USERNAME=analyst
# ANALYST_PASSWORD_HASH=$2b$12$0cVHZzt7RqT5BTAgNZZbbOybx4plrJklXewhawpsSNlV9943DyTxG

# Email Integration (Optional)
IMAP_SERVER=
IMAP_USER=
IMAP_PASS=

# External Threat Intelligence (Optional - VirusTotal v3-compatible API)
# Leave THREAT_INTEL_API_KEY blank to disable; indicator checks will report
# status "unavailable" and the analysis pipeline runs fine without it.
THREAT_INTEL_API_KEY=
THREAT_INTEL_BASE_URL=https://www.virustotal.com/api/v3
THREAT_INTEL_TIMEOUT_SECONDS=6.0
THREAT_INTEL_MAX_RETRIES=2
THREAT_INTEL_MAX_INDICATORS=5

# Rate limiting storage (Optional but recommended for production)
# Leave blank for single-instance/dev use (in-memory, per-process limits).
# Set to a shared Redis instance if running multiple workers/replicas, so
# rate limits are enforced consistently across all of them. Requires the
# `redis` package (uncomment it in requirements.txt) when used.
RATE_LIMIT_STORAGE_URI=

# Logging
LOG_LEVEL=INFO

# Production ASGI server concurrency (Dockerfile's gunicorn CMD reads this).
# Default 2. Tune based on the instance's CPU/RAM - each worker loads its
# own copy of the NLP model when ENABLE_HEAVY_NLP=true, which is memory-heavy.
WEB_CONCURRENCY=2

# GeoIP (Optional - see scripts/update_geoip_db.py)
# Without these, geolocation falls back to a clearly-labeled simulated
# location (see services/geoip_service.py). Get a free MaxMind account +
# license key at https://www.maxmind.com/en/geolite2/signup to enable real
# lookups.
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
MAXMIND_EDITION_ID=GeoLite2-City

# Real-time WebSocket multi-instance sync
REDIS_URL=redis://localhost:6379
